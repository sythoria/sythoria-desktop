{
  "id": "todoist",
  "name": "Todoist",
  "category": "productivity",
  "description": "Create tasks, check upcoming deadlines, and organize project tasks.",
  "icon": "./icon.svg",
  "authType": "api_key",
  "authFields": [
    {
      "key": "TODOIST_API_KEY",
      "label": "Todoist API Token",
      "placeholder": "Token...",
      "type": "password",
      "required": true,
      "docUrl": "https://todoist.com/app/settings/integrations/developer"
    }
  ],
  "preset": {
    "id": "todoist",
    "name": "Todoist",
    "description": "Task and project management with Todoist.",
    "command": "npx",
    "args": ["-y", "@doist/todoist-mcp"],
    "envKeys": ["TODOIST_API_KEY"],
    "homepageUrl": "https://github.com/Doist/todoist-mcp"
  },
  "keywords": ["todoist", "tasks", "todo", "deadlines", "reminders", "projects"]
}
